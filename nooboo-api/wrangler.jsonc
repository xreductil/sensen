{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nooboo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "STOREFRONT_CHANNEL": "b2c",
    "LINE_PAY_ENV": "production",
    "LINE_PAY_SITE_ORIGIN": "https://nooboo.vercel.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sensen-db",
      "database_id": "8d3a1009-ed46-47de-afa2-9c5c5c1438bb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sensen-images"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "2026101701",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_WRITE_LIMITER",
      "namespace_id": "2026101702",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "2026101703",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "2026101704",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
}
